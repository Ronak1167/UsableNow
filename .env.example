# UsableNow Environment Configuration
PROJECT_NAME="UsableNow"
VERSION="1.0.0"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./usablenow.db"

# CORS configuration (comma-separated or list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Environment Mode: "development", "demo", "production", or "test"
ENVIRONMENT="development"

# Evidence Mode: "demo" (seeded mock data active), "live" (strictly real-world student reports), "hybrid"
EVIDENCE_MODE="demo"

# Admin Key for Demonstration Reset / Moderation
# In non-demo/production environments, a strong non-default secret is strictly required
ADMIN_SECRET_KEY=""

# Optional AI Integration (Provider-independent with deterministic local fallback)
# Leave blank to use deterministic local parsing and summary generation without external cost.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Google Maps Platform (Optional - enables static maps, embeds, geocoding & directions)
GOOGLE_MAPS_API_KEY=""

# Half-Life Decay Parameters (Hours)
DEFAULT_HALF_LIFE_HOURS=6.0
PHYSICAL_HALF_LIFE_HOURS=48.0
